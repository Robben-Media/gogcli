[
  {
    "intent_id": "admin.change_user_lifecycle",
    "service": "admin",
    "applies_to": [
      "google_admin_directory_users_get",
      "google_admin_directory_users_patch"
    ],
    "required_facts": [
      {
        "key": "user_key",
        "format": "immutable user ID preferred; exact primary email accepted",
        "reason": "Resolves one Workspace user.",
        "source": "caller"
      },
      {
        "key": "lifecycle_patch",
        "format": "User JSON containing only suspended or primaryEmail",
        "reason": "Limits this recipe to suspend, unsuspend, or rename; deletion and restoration require separate contracts.",
        "source": "caller"
      },
      {
        "key": "immutable_user_id",
        "format": "Directory immutable user id",
        "reason": "users.get id; user_key/email never substitutes.",
        "source": "lookup",
        "produced_by": "google_admin_directory_users_get"
      },
      {
        "key": "current_suspended",
        "format": "boolean",
        "reason": "Current User.suspended from users.get.",
        "source": "lookup",
        "produced_by": "google_admin_directory_users_get"
      },
      {
        "key": "current_primary_email",
        "format": "exact primaryEmail",
        "reason": "Current User.primaryEmail from users.get.",
        "source": "lookup",
        "produced_by": "google_admin_directory_users_get"
      }
    ],
    "steps": [
      {
        "operation": "google_admin_directory_users_get",
        "kind": "lookup",
        "inputs": [
          {
            "name": "userKey",
            "location": "path",
            "format": "string",
            "source": "fact:user_key"
          }
        ],
        "skip_if_facts": [
          "immutable_user_id",
          "current_suspended",
          "current_primary_email"
        ],
        "produces": [
          "immutable_user_id",
          "current_suspended",
          "current_primary_email"
        ]
      },
      {
        "operation": "google_admin_directory_users_patch",
        "kind": "write",
        "inputs": [
          {
            "name": "userKey",
            "location": "path",
            "format": "immutable user ID",
            "source": "fact:immutable_user_id"
          },
          {
            "name": "body",
            "location": "body",
            "format": "User with only suspended or primaryEmail",
            "source": "fact:lifecycle_patch"
          }
        ]
      }
    ],
    "call_estimate_min": 2,
    "call_estimate_max": 2,
    "stop_rules": {
      "revision": "Call users.get unless caller facts include immutable_user_id and the current value of every lifecycle field being compared or changed; user_key or email alone never skips the lookup.",
      "idempotency": "Use absolute suspended or primaryEmail values and retain the immutable user ID.",
      "reconcile": "users.patch returns User. GET by immutable ID only if the patch outcome is unknown or the returned User is incomplete. Never infer state from the old or new email. Delete is out of scope."
    }
  },
  {
    "intent_id": "docs.edit_existing",
    "service": "docs",
    "applies_to": [
      "google_docs_documents_get",
      "google_docs_documents_batchupdate"
    ],
    "required_facts": [
      {
        "key": "document_id",
        "format": "exact document ID",
        "reason": "Bounds the edit to one document.",
        "source": "caller"
      },
      {
        "key": "requests",
        "format": "1-25 ordered Docs API requests",
        "reason": "Consequential edits remain explicit raw batchUpdate requests.",
        "source": "caller"
      },
      {
        "key": "revision_id",
        "format": "Document.revisionId",
        "reason": "writeControl.requiredRevisionId",
        "source": "lookup",
        "produced_by": "google_docs_documents_get"
      }
    ],
    "steps": [
      {
        "operation": "google_docs_documents_get",
        "kind": "lookup",
        "inputs": [
          {
            "name": "documentId",
            "location": "path",
            "format": "string",
            "source": "fact:document_id"
          },
          {
            "name": "fields",
            "location": "query",
            "format": "revisionId plus only affected structural fields",
            "source": "caller"
          }
        ],
        "skip_if_facts": [
          "revision_id"
        ],
        "produces": [
          "revision_id"
        ]
      },
      {
        "operation": "google_docs_documents_batchupdate",
        "kind": "write",
        "inputs": [
          {
            "name": "documentId",
            "location": "path",
            "format": "string",
            "source": "fact:document_id"
          },
          {
            "name": "requests",
            "location": "body",
            "format": "Request array, max 25; validate affected ranges against the referenced revision",
            "source": "fact:requests"
          },
          {
            "name": "writeControl.requiredRevisionId",
            "location": "body",
            "format": "opaque revision ID",
            "source": "fact:revision_id"
          }
        ]
      }
    ],
    "call_estimate_min": 2,
    "call_estimate_max": 2,
    "stop_rules": {
      "revision": "Use requiredRevisionId; stop on mismatch and rebuild from a fresh read.",
      "idempotency": "Do not replay an old request batch against a newer revision.",
      "reconcile": "Re-read affected content only if batchUpdate outcome is unknown or requiredRevisionId mismatches. Do not add an unconditional trailing get."
    }
  },
