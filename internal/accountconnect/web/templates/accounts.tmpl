{{define "page-head"}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Google accounts - gog</title>
<style>
:root { color-scheme: dark; --bg: #101215; --surface: #181b20; --surface-2: #20242b; --text: #f1f4f7; --muted: #a9b3bd; --border: #30363f; --accent: #91caff; --accent-strong: #1c5a99; --danger: #ffb4ab; --success: #9adda5; --focus: #b7d8ff; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font-size: 16px; line-height: 1.45; }
main { max-width: 940px; margin: 0 auto; padding: 32px 20px 56px; }
h1 { margin: 0 0 24px; font-size: 1.75rem; line-height: 1.2; }
h2 { margin: 0; font-size: 1.0625rem; line-height: 1.3; }
a { color: var(--accent); }
.accounts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding: 0; margin: 0 0 32px; list-style: none; }
.account, .connect-panel, .status-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
.account { padding: 16px; }
.account-header { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
.label { overflow-wrap: anywhere; }
.email { margin: 3px 0 12px; color: var(--muted); overflow-wrap: anywhere; }
.capabilities { margin: 0 0 16px; padding: 0; list-style: none; display: grid; gap: 6px; }
.capabilities li { display: flex; justify-content: space-between; gap: 12px; min-height: 24px; align-items: center; border-bottom: 1px solid var(--border); }
.capabilities li:last-child { border-bottom: 0; }
.capability-status { color: var(--success); font-size: .875rem; }
.none { margin: 0 0 16px; color: var(--muted); }
.state-note { margin: 0 0 16px; color: var(--muted); font-size: .8125rem; }
.actions { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px; }
.reconnect-access { border: 0; margin: 0 0 14px; padding: 0; }
.reconnect-access legend { margin-bottom: 7px; }
.warning { width: 100%; margin: 7px 0 0; color: var(--muted); font-size: .8125rem; }
button, .return { border-radius: 6px; border: 1px solid var(--border); min-height: 36px; padding: 7px 12px; font: inherit; font-size: .9375rem; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
button { cursor: pointer; background: var(--surface-2); color: var(--text); }
button:hover { border-color: #49525d; background: #272c34; }
button.primary { background: var(--accent-strong); border-color: #71a7d8; color: #fff; }
button.primary:hover { background: #21669f; }
:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
.connect-panel, .status-panel { max-width: 560px; padding: 18px; }
.field { display: grid; gap: 6px; margin-bottom: 16px; }
label, legend { font-weight: 650; }
input[type="text"] { width: 100%; min-height: 38px; border-radius: 6px; border: 1px solid var(--border); background: #0e1013; color: var(--text); padding: 8px 10px; font: inherit; }
input[type="text"]:hover { border-color: #49525d; }
fieldset { border: 0; margin: 0 0 18px; padding: 0; }
legend { margin-bottom: 7px; }
.choices { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
.choice { display: flex; align-items: center; gap: 9px; min-height: 28px; }
.choice label { font-weight: 400; width: 100%; }
.choice input { width: 18px; height: 18px; accent-color: var(--accent-strong); }
.status-panel { margin: 48px auto 0; }
.status-heading { margin: 0 0 9px; font-size: 1.375rem; }
.status-message { margin: 0 0 20px; color: var(--muted); overflow-wrap: anywhere; }
.status-account { margin: 0 0 20px; color: var(--muted); }
.empty { color: var(--muted); margin: 0 0 28px; }
@media (max-width: 679px) { main { padding: 22px 14px 40px; } .accounts { grid-template-columns: 1fr; } .account-header { align-items: flex-start; flex-direction: column; } }
</style>
</head>
<body>
{{end}}

{{define "page-foot"}}
</body>
</html>
{{end}}

{{define "account-card"}}
<li class="account">
<article>
<div class="account-header">
<h2 class="label">{{if .Label}}{{.Label}}{{else}}Google account{{end}}</h2>
</div>
<p class="email">{{.Email}}</p>
{{if .StateNote}}<p class="state-note">{{.StateNote}}</p>{{end}}
{{if .IsActive}}{{if .Capabilities}}
<ul class="capabilities">
{{range .Capabilities}}
<li><span>{{.Name}}</span><span class="capability-status">{{.Status}}</span></li>
{{end}}
</ul>
{{else}}
<p class="none">No supported capabilities are granted.</p>
{{end}}{{end}}
<div class="actions">
{{if .IsPending}}
<form method="post" action="/reconnect">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="account_id" value="{{.AccountID}}">
<button type="submit">Finish connection</button>
</form>
{{else if .IsDisconnecting}}
<form method="post" action="/disconnect">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="account_id" value="{{.AccountID}}">
<button type="submit">Retry disconnect</button>
<p class="warning">Disconnecting removes this connection. Other deployments using the same Google grant may be affected.</p>
</form>
{{else}}
<form method="post" action="/reconnect">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="account_id" value="{{.AccountID}}">
<input type="hidden" name="capabilities" value="">
{{if .AdditionalChoices}}
<fieldset class="reconnect-access">
<legend>Add Google access</legend>
<ul class="choices">
{{range $index, $choice := .AdditionalChoices}}
<li class="choice">
<input id="{{$.FormID}}-scope-{{$index}}" type="checkbox" name="capabilities" value="{{$choice.Capability}}">
<label for="{{$.FormID}}-scope-{{$index}}">{{$choice.Name}}</label>
</li>
{{end}}
</ul>
</fieldset>
{{end}}
<button type="submit">Reconnect</button>
</form>
<form method="post" action="/disconnect">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="account_id" value="{{.AccountID}}">
<button type="submit">Disconnect</button>
<p class="warning">Disconnecting removes this connection. Other deployments using the same Google grant may be affected.</p>
</form>
{{end}}
</div>
</article>
</li>
{{end}}

{{define "accounts"}}
{{template "page-head"}}
<main>
<h1>Google accounts</h1>
{{if .Accounts}}
<ul class="accounts">
{{range .Accounts}}{{template "account-card" .}}{{end}}
</ul>
{{else}}
<p class="empty">No Google accounts are connected.</p>
{{end}}
<section class="connect-panel" aria-labelledby="connect-heading">
<h2 id="connect-heading">{{.ConnectHeading}}</h2>
<form method="post" action="/connect">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="capabilities" value="">
<div class="field">
<label for="label">Display label</label>
<input id="label" name="label" type="text" maxlength="80" autocomplete="off" placeholder="Personal">
</div>
{{if .CapabilityChoices}}
<fieldset>
<legend>Access Google will request</legend>
<ul class="choices">
{{range $index, $choice := .CapabilityChoices}}
<li class="choice">
<input id="scope-{{$index}}" type="checkbox" name="capabilities" value="{{$choice.Capability}}"{{if $choice.Checked}} checked{{end}}>
<label for="scope-{{$index}}">{{$choice.Name}}</label>
</li>
{{end}}
</ul>
</fieldset>
{{end}}
<button class="primary" type="submit">{{.ConnectButton}}</button>
</form>
</section>
</main>
{{template "page-foot"}}
{{end}}

{{define "status"}}
{{template "page-head"}}
<main>
<section class="status-panel" id="status" tabindex="-1" autofocus role="status" aria-live="polite" aria-labelledby="status-heading">
<h2 class="status-heading" id="status-heading">{{.Heading}}</h2>
{{if .Account}}<p class="status-account">{{if .Account.Label}}{{.Account.Label}} · {{end}}{{.Account.Email}}</p>{{end}}
<p class="status-message">{{.Message}}</p>
<a class="return" href="/accounts">Return to Google accounts</a>
</section>
</main>
{{template "page-foot"}}
{{end}}
